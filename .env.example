# Model — routed through the Vercel AI Gateway (agent/agent.ts).
AI_GATEWAY_API_KEY=
# Optional: override the gateway model slug.
# EVE_MODEL=anthropic/claude-sonnet-5
# To use a provider SDK directly instead, switch agent/agent.ts and set its key:
# ANTHROPIC_API_KEY=

# Kernel cloud browser — authenticated per-user through Vercel Connect, no API key.
# Set up the connector once (see README) and leave KERNEL_API_KEY unset.
# Prefer a single org-scoped access token for everyone instead of per-user
# Connect auth? Remove the `connect` option in agent/extensions/kernel.ts
# (mount `kernel({})`) and set KERNEL_API_KEY here — `connect` takes
# precedence, so the key is ignored while it's still passed.
# KERNEL_API_KEY=

# Slack — only for the classic Slack app path. The default channel uses Vercel
# Connect, which manages these for you; leave them unset (see README).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
