# Model — this example defaults to the direct Anthropic provider.
ANTHROPIC_API_KEY=
# Optional: override the Anthropic model id.
# EVE_MODEL=claude-sonnet-4-6
# On Vercel you can instead use the AI Gateway (set agent/agent.ts to a slug):
# AI_GATEWAY_API_KEY=

# Kernel cloud browser — get a key at https://www.kernel.sh
KERNEL_API_KEY=

# Slack channel (classic Slack app path) — from your Slack app settings.
# Omit if you use Vercel Connect instead (see README).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
